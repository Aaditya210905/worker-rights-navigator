# AssemblyAI — Required for voice features + LeMUR
ASSEMBLYAI_API_KEY=your_key_here

# HuggingFace — Required for cloud embedding (used in production)
HF_TOKEN=hf_YOUR_TOKEN_HERE

# Embedding backend: "ollama" (local dev) or "huggingface" (cloud/production)
EMBEDDING_BACKEND=ollama

# Application
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
