# ── Docker Ignore — WorkerSaathi ────────────────────────────────
# Keep the image small by excluding dev-only files.

# Version control
.git
.gitignore

# Virtual environments
venv/
.venv/
env/
ENV/

# Frontend dev tooling (none required — served as static files)
frontend/node_modules/

# IDE
.vscode/
.idea/
.cursor/
.gemini/

# Python caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Dev files
*.md
!backend/knowledge/**/*.md
backend/tests/
brain/
scratch/
*.log

# Environment (secrets set via Render dashboard)
.env
.env.*
!.env.example

# Temporary
*.tmp
*.bak
*.swp
