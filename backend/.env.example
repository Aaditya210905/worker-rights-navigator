# ── Embedding (OpenAI-compatible / OpenRouter) ───────────────────────────────
# Free embedding model: nvidia/nemotron-3-embed-1b:free via OpenRouter
# Get your free key at https://openrouter.ai/keys
EMBEDDING_BACKEND=openai
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# ── Sarvam AI (Voice — Saaras v4 STT + Bulbul v3 TTS) ─────────────────────────
# Get your key at https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_key_here

# ── LLM (OpenAI-compatible endpoint) ──────────────────────────────────────────
# Default: Groq (free tier, fastest for Indic languages)
# Get your key at https://console.groq.com/keys
LLM_API_KEY=your_groq_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# Application
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
